{
  "name": "@keyringjs/keyring",
  "version": "0.1.1",
  "description": "Browser helpers for Keyring: WebAuthn ceremonies and Inertia bindings for Vue and React.",
  "license": "MIT",
  "keywords": [
    "laravel",
    "authentication",
    "webauthn",
    "passkeys",
    "inertia"
  ],
  "homepage": "https://github.com/entity/keyring/blob/main/docs/frontend.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entity/keyring.git",
    "directory": "js"
  },
  "bugs": "https://github.com/entity/keyring/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inertia": {
      "types": "./dist/inertia.d.ts",
      "import": "./dist/inertia.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@inertiajs/core": "^3.0.0",
    "@inertiajs/react": "^3.0.0",
    "@inertiajs/vue3": "^3.0.0",
    "react": "^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@inertiajs/core": {
      "optional": true
    },
    "@inertiajs/react": {
      "optional": true
    },
    "@inertiajs/vue3": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inertiajs/core": "^3.0.0",
    "@inertiajs/react": "^3.0.0",
    "@inertiajs/vue3": "^3.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vue": "^3.5.0"
  }
}
