{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": ".",
    "types": [],
    "paths": {
      "@entity/keyring": [
        "./src/index.ts"
      ],
      "@entity/keyring/vue": [
        "./src/vue.ts"
      ],
      "@entity/keyring/react": [
        "./src/react.ts"
      ],
      "vue": [
        "./node_modules/vue"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "@inertiajs/vue3": [
        "./node_modules/@inertiajs/vue3"
      ],
      "@inertiajs/react": [
        "./node_modules/@inertiajs/react"
      ]
    }
  },
  "include": [
    "../stubs/inertia/**/*.ts",
    "../stubs/inertia/**/*.tsx",
    "../stubs/inertia/**/*.vue",
    "src"
  ]
}