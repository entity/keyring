{
    "name": "keyring/keyring",
    "description": "Factor-driven authentication for Laravel: many authenticators per user, devices, sessions, step-up and risk.",
    "keywords": [
        "laravel",
        "auth",
        "mfa",
        "2fa",
        "webauthn",
        "passkeys",
        "totp"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "bacon/bacon-qr-code": "^3.0",
        "laravel/framework": "^13.31",
        "paragonie/constant_time_encoding": "^3.0",
        "pragmarx/google2fa": "^9.0",
        "spomky-labs/cbor-php": "^3.4",
        "spomky-labs/pki-framework": "^1.6.2",
        "symfony/polyfill-intl-normalizer": "^1.31",
        "symfony/serializer": "^6.4|^7.0|^8.0",
        "web-auth/cose-lib": "^4.8",
        "web-auth/webauthn-lib": "^5.3.10"
    },
    "autoload": {
        "psr-4": {
            "Keyring\\": "src/",
            "Keyring\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keyring\\Tests\\": "tests/",
            "App\\": "stubs/app/"
        },
        "files": [
            "tests/Helpers.php",
            "tests/Concurrency/Helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Keyring\\KeyringServiceProvider"
            ],
            "aliases": {
                "Keyring": "Keyring\\Facades\\Keyring"
            }
        }
    },
    "scripts": {
        "test": "pest --parallel",
        "lint": "pint",
        "refactor": "rector",
        "analyse": [
            "phpstan analyse",
            "phpstan analyse -c phpstan.stubs.neon"
        ],
        "check": [
            "rector --dry-run",
            "pint --test",
            "phpstan analyse",
            "phpstan analyse -c phpstan.stubs.neon",
            "pest --parallel"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "calebdw/phpstan-laravel": "^1.12",
        "driftingly/rector-laravel": "^2.7",
        "inertiajs/inertia-laravel": "^3.7",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.8"
    }
}
