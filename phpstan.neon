includes:
    - vendor/calebdw/phpstan-laravel/extension.neon

parameters:
    level: 8
    paths:
        - src
        - tests/Fixtures
        - tests/TestCase.php
        - tests/Feature/ConformanceTest.php
    laravel:
        rules:
            # Keyring's services live for a whole Octane worker.
            octaneCompatibility: true
